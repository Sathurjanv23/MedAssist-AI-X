# MedAssist AI X — Environment Variables Template
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# ─── JWT ─────────────────────────────────────────────────────────────────────
# Must be at least 64 characters for HS512 signing
JWT_SECRET=your-super-secret-jwt-key-must-be-at-least-64-characters-long-for-hs512!!
JWT_EXPIRATION=3600000       # 1 hour in milliseconds
JWT_REFRESH_EXPIRATION=604800000  # 7 days in milliseconds

# ─── MongoDB ──────────────────────────────────────────────────────────────────
# For local Docker: mongodb://localhost:27017/medassist
MONGODB_URI=mongodb://localhost:27017/medassist

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ─── AWS ──────────────────────────────────────────────────────────────────────
# Create IAM user with S3 and SES permissions
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_REGION=us-east-1
AWS_S3_BUCKET=medassist-reports
AWS_SES_FROM_EMAIL=noreply@medassist.ai

# ─── AI (Ollama) ──────────────────────────────────────────────────────────────
# Local Ollama: http://localhost:11434
# Docker: http://ollama:11434
AI_SERVICE_URL=http://localhost:11434
AI_MODEL=llama3.2

# ─── OCR Service ─────────────────────────────────────────────────────────────
# Local: http://localhost:5001
# Docker: http://ocr:5001
OCR_SERVICE_URL=http://localhost:5001

# ─── Application ──────────────────────────────────────────────────────────────
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080
APP_ISSUER=medassist-ai-x

# ─── Frontend ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_WS_URL=ws://localhost:8080/ws
